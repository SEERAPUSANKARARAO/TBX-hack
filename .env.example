# ── LLM Configuration ──
# Active Provider: openrouter | ollama | openai | groq
LLM_PROVIDER=openrouter

# OpenRouter API (Access 100+ models: Qwen 2.5 Coder, Claude 3.5 Haiku, LLaMA, DeepSeek, GPT)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b-instruct

# OpenAI-compatible API (fallback)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Groq — recommended for live demos: dedicated per-org quota, not a shared
# contended pool like OpenRouter's free tier, so it doesn't stack up 429s.
# llama-3.1-8b-instant is no longer on Groq's free tier (Enterprise-only as
# of 2026) — verify current models with GET https://api.groq.com/openai/v1/models
GROQ_API_KEY=gsk-your-api-key-here
# Running several free-tier Groq accounts side by side? Set GROQ_API_KEYS
# instead (comma-separated) — the app automatically rotates to the next key
# on a 429 (rate limited) or 401/403 (rejected), so one exhausted key
# doesn't stall the whole app. Takes priority over the single GROQ_API_KEY
# above when set.
GROQ_API_KEYS=gsk-key-one,gsk-key-two,gsk-key-three,gsk-key-four,gsk-key-five
GROQ_MODEL=openai/gpt-oss-20b

# ── Database (MySQL) ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=finquery
# Full-privilege user, used only by db/init_db.py to create schema and load data.
DB_ADMIN_USER=finquery_app
DB_ADMIN_PASSWORD=change-me
# SELECT-only user (GRANT SELECT ON finquery.* TO this user) — used by the actual
# query-execution runtime. Enforces read-only at the database level, not just in code.
DB_READONLY_USER=finquery_ro
DB_READONLY_PASSWORD=change-me

# ── Application ──
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# ── Guardrails ──
MAX_SQL_RETRIES=2
ANOMALY_SIGMA_THRESHOLD=2.5
FUZZY_MATCH_THRESHOLD=90
