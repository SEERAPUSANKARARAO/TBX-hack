# ── LLM Configuration ──
# Active Provider: openrouter | ollama | openai | groq
LLM_PROVIDER=openrouter

# OpenRouter API (Access 100+ models: Qwen 2.5 Coder, Claude 3.5 Haiku, LLaMA, DeepSeek, GPT)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b-instruct

# OpenAI-compatible API (fallback)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Groq (alternative)
GROQ_API_KEY=gsk-your-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# ── Database ──
DUCKDB_PATH=./db/financial.duckdb

# ── Application ──
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# ── Guardrails ──
MAX_SQL_RETRIES=2
ANOMALY_SIGMA_THRESHOLD=2.5
FUZZY_MATCH_THRESHOLD=90
